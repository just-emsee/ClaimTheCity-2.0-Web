
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Permit WebAssembly compilation for Unity WebGL.
    add_header Content-Security-Policy "default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https:; connect-src 'self' https: wss: data: blob:; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:; media-src 'self' https: data: blob:; worker-src 'self' blob:;" always;

    # Uncompressed WebAssembly.
    location ~* \.wasm$ {
        default_type application/wasm;
        try_files $uri =404;
    }

    # Gzip-compressed Unity files.
    location ~* \.(wasm|js|data|framework\.js)\.gz$ {
        gzip off;
        add_header Content-Encoding gzip;
        add_header Content-Security-Policy "default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https:; connect-src 'self' https: wss: data: blob:; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:; media-src 'self' https: data: blob:; worker-src 'self' blob:;" always;
        types {
            application/wasm wasm;
            application/javascript js;
            application/octet-stream data;
        }
        default_type application/octet-stream;
        try_files $uri =404;
    }

    # Brotli-compressed Unity files.
    location ~* \.(wasm|js|data|framework\.js)\.br$ {
        gzip off;
        add_header Content-Encoding br;
        add_header Content-Security-Policy "default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https:; connect-src 'self' https: wss: data: blob:; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:; media-src 'self' https: data: blob:; worker-src 'self' blob:;" always;
        default_type application/octet-stream;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
