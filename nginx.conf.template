server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Allow WebAssembly compilation for Unity WebGL.
    add_header Content-Security-Policy "default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https:; connect-src 'self' https: wss: data: blob:; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:; media-src 'self' https: blob: data:; worker-src 'self' blob:;" always;

    # Correct MIME types for Unity files.
    include /etc/nginx/mime.types;

    location / {
        try_files $uri $uri/ =404;
    }

    # Uncompressed WebAssembly.
    location ~* \.wasm$ {
        default_type application/wasm;
    }

    # Gzip-compressed WebAssembly.
    location ~* \.wasm\.gz$ {
        gzip on;
        add_header Content-Encoding gzip;
        default_type application/wasm;
    }

    # Brotli-compressed WebAssembly.
    location ~* \.wasm\.br$ {
        gzip on;
        add_header Content-Encoding br;
        default_type application/wasm;
    }

    # Gzip-compressed Unity JavaScript.
    location ~* \.js\.gz$ {
        gzip on;
        add_header Content-Encoding gzip;
        default_type application/javascript;
    }

    # Brotli-compressed Unity JavaScript.
    location ~* \.js\.br$ {
        gzip on;
        add_header Content-Encoding br;
        default_type application/javascript;
    }

    # Gzip-compressed Unity data files.
    location ~* \.(data|symbols\.json)\.gz$ {
        gzip on;
        add_header Content-Encoding gzip;
        default_type application/octet-stream;
    }

    # Brotli-compressed Unity data files.
    location ~* \.(data|symbols\.json)\.br$ {
        gzip on;
        add_header Content-Encoding br;
        default_type application/octet-stream;
    }
}
